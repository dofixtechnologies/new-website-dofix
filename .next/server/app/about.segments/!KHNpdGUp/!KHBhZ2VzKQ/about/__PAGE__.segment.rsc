d:["$","div",null,{"className":"mb-8","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-semibold mb-3","children":"3. What We Do"}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":["At DoFix, we provide a wide range of home repair services designed to keep your home functioning smoothly and looking its best. Whether you need a small repair or complete maintenance support, our experts are ready to help.",["$","br",null,{}],["$","br",null,{}],["$","span",null,{"className":"font-semibold text-[#14455b]","children":"Our services include:"}],["$","br",null,{}],["$","br",null,{}],["$","span",null,{"className":"font-semibold text-[#14455b]","children":"AC Repair and Installation / Uninstallation Services"}],["$","br",null,{}],"From quick repairs to safe setup or removal, our experts provide reliable doorstep service.",["$","br",null,{}],["$","br",null,{}],["$","span",null,{"className":"font-semibold text-[#14455b]","children":"Electrical Repairs & Installations"}],["$","br",null,{}],"From fixing faulty switches to installing lighting systems, our technicians ensure safe and efficient electrical solutions.",["$","br",null,{}],["$","br",null,{}],["$","span",null,{"className":"font-semibold text-[#14455b]","children":"Plumbing Services"}],["$","br",null,{}],"Leaking taps, clogged drains, pipe repairs, or bathroom fittings—our professionals handle all plumbing tasks with expertise.",["$","br",null,{}],["$","br",null,{}],["$","span",null,{"className":"font-semibold text-[#14455b]","children":"Appliance Repair"}],["$","br",null,{}],"We repair and service appliances like washing machines, refrigerators, water purifiers, and air conditioners.",["$","br",null,{}],["$","br",null,{}],["$","span",null,{"className":"font-semibold text-[#14455b]","children":"Carpentry & Woodwork"}],["$","br",null,{}],"Our skilled carpenters provide furniture repairs, door and window fixes, and custom woodwork.",["$","br",null,{}],["$","br",null,{}],["$","span",null,{"className":"font-semibold text-[#14455b]","children":"Painting & Home Improvement"}],["$","br",null,{}],"Give your home a fresh look with our painting and renovation solutions.",["$","br",null,{}],["$","br",null,{}],["$","span",null,{"className":"font-semibold text-[#14455b]","children":"Deep Cleaning & Maintenance"}],["$","br",null,{}],"We also offer professional cleaning and maintenance services to ensure your home remains hygienic and comfortable.",["$","br",null,{}],["$","br",null,{}],"As one of the dependable housing maintenance companies, we aim to provide a complete solution under one roof so customers don’t need to contact multiple service providers."]}]]}]
e:["$","div",null,{"children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-semibold mb-3","children":"4. Our Process"}],["$","p",null,{"className":"text-gray-600 leading-relaxed","children":["We have designed a simple and efficient process that allows homeowners to book professional home repair services quickly and easily.",["$","br",null,{}],["$","br",null,{}],["$","span",null,{"className":"font-semibold text-[#14455b]","children":"Step 1: Book a Service"}],["$","br",null,{}],"Customers can easily schedule their required home repair services through our website or app. Simply select the service you need and choose a convenient time.",["$","br",null,{}],["$","br",null,{}],["$","span",null,{"className":"font-semibold text-[#14455b]","children":"Step 2: Technician Assignment"}],["$","br",null,{}],"Once the booking is confirmed, we assign a skilled technician who specializes in the required service.",["$","br",null,{}],["$","br",null,{}],["$","span",null,{"className":"font-semibold text-[#14455b]","children":"Step 3: Inspection & Estimate"}],["$","br",null,{}],"Our expert visits your home, inspects the issue, and provides a transparent estimate before starting the work.",["$","br",null,{}],["$","br",null,{}],["$","span",null,{"className":"font-semibold text-[#14455b]","children":"Step 4: Repair & Service"}],["$","br",null,{}],"After approval, our home repair experts complete the job using professional tools and quality materials.",["$","br",null,{}],["$","br",null,{}],["$","span",null,{"className":"font-semibold text-[#14455b]","children":"Step 5: Quality Check & Completion"}],["$","br",null,{}],"Before finishing the service, we ensure everything works perfectly and meets our quality standards.",["$","br",null,{}],["$","br",null,{}],"This streamlined process helps customers get quick and hassle-free home services in Delhi NCR."]}]]}]
